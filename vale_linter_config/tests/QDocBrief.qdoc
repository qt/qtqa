/*!
    \fn bool QRect::contains(const QPoint &p) const
    \brief Returns \c true if the point is inside the rectangle, \c false otherwise

    The point is considered inside if it is on the boundary.
*/

// SHOULD NOT WARN: \brief with inline commands — period follows closing \c{}.

/*!
    \fn bool QRect::isEmpty() const
    \brief Returns \c true if the rectangle is empty, \c false otherwise.

    An empty rectangle has zero width or zero height.
*/

